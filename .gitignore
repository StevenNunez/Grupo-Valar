# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (el workspace puede crear una por app)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (una carpeta por app del workspace)
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# instrucciones y notas internas de trabajo con IA (no van al repo público)
CLAUDE.md
AGENTS.md
.claude/

# cloudflare
.wrangler/
