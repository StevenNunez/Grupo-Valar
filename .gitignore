# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (el workspace puede crear una por app)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (una carpeta por app del workspace)
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# instrucciones y notas internas de trabajo con IA (no van al repo público)
CLAUDE.md
AGENTS.md
.claude/

# cloudflare
.wrangler/

# Datos reales extraidos de las planillas: cifras de la empresa, no van al repo
scripts/planillas/datos-valar.json
scripts/planillas/proveedores.json
scripts/planillas/articulos.json

# estado local de la CLI de Supabase
supabase/.temp/

# Notas internas de trabajo: no van al repo
MEMORIA.md
.local/


CONFIGURACION_ACCESO.md

# Herramientas de desarrollo: sembrar el demo, verificar RLS, importar planillas,
# diagnosticar SMTP, aplicar migraciones, vaciar la base. Viven en local; la
# app no las importa y GitHub no las necesita para compilar ni para estar en vivo.
scripts/

# La plantilla de variables de la plataforma SÍ va: dice qué necesita el build.
# (La de la raíz es para los scripts locales y queda fuera con ellos.)
!apps/plataforma/.env.example

# Documentación interna (contrato con Pagnol, etc.): no va al repo
docs/
