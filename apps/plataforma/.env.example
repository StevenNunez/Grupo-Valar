# Claves que la plataforma incrusta en el build. Copiar a .env.local.
#
# Las dos son PÚBLICAS por diseño: viajan dentro del bundle del navegador. Lo
# que impide leer datos con ellas son las políticas RLS de Postgres.
# La clave service_role NO va nunca acá.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
