# Claves que la plataforma incrusta en el build. Copiar a .env.local.
#
# Las dos son PÚBLICAS por diseño: viajan dentro del bundle del navegador. Lo
# que impide leer datos con ellas son las políticas RLS de Postgres.
# La clave service_role NO va nunca acá.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Integración con Pagnol (www.pagnol.cl). SOLO SERVIDOR: nunca con prefijo
# NEXT_PUBLIC_. La llave se crea en Pagnol → Configuración → "Integraciones —
# API de Pagnol", y en producción vive en las variables de Vercel.
PAGNOL_API_URL=https://www.pagnol.cl/api/v1
PAGNOL_API_KEY=

# Webhooks de Pagnol (Fase 3). El secreto lo entrega Pagnol al registrar la
# URL https://plataforma.grupovalar.cl/api/webhooks/pagnol/ (con barra final).
PAGNOL_WEBHOOK_SECRET=

# Clave de servicio de Supabase. SOLO SERVIDOR: se salta RLS. La usa el
# webhook de Pagnol, que llega sin la sesión de ninguna persona.
SUPABASE_SERVICE_ROLE_KEY=
